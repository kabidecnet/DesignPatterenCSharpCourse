## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
*.log

# Visual Studio 2017/2019/2022 cache/options directory
.vs/
.vscode/

# .NET Core & .NET 5+/6/7/8 artifacts
artifacts/
*.db
*.cache
*.deps.json
*.runtimeconfig.json

# NUGET packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# Windows image file caches
Thumbs.db
ehthumbs.db

# Rider
.idea/

# OS generated files
.DS_Store
*.swp

# Others
*.vspscc
*.vssscc
*.pdb
*.exe
*.dll

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Local history for Visual Studio
.localhistory/

# DotCover
*.dotCover

# JetBrains Rider
.idea/
*.sln.iml
